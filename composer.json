{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mfd/cloudfront-trusted-proxies",
    "description": "Trust AWS CloudFront's published edge IP ranges as reverse proxies",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "version": "1.1.5",
    "keywords": [
        "TYPO3 CMS",
        "Extension",
        "AWS",
        "CloudFront",
        "reverseProxyIP"
    ],
    "authors": [
        {
            "name": "Ingo Schmitt",
            "role": "Developer",
            "email": "ingo.schmitt@marketing-factory.de",
            "homepage": "https://www.marketing-factory.de"
        }
    ],
    "support": {
        "issues": "https://github.com/marketing-factory/cloudfront_trusted_proxies/issues",
        "source": "https://github.com/marketing-factory/cloudfront_trusted_proxies",
        "docs": "https://docs.typo3.org/p/mfd/cloudfront-trusted-proxies/main/en-us/",
        "security": "https://github.com/marketing-factory/cloudfront_trusted_proxies/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.3",
        "typo3/cms-core": "^13.0 || ^14.0"
    },
    "require-dev": {
        "typo3/testing-framework": "^9.3",
        "phpunit/phpunit": "^11.0",
        "guzzlehttp/psr7": "^2.10"
    },
    "suggest": {
        "mfd/cdn-utils": "*"
    },
    "autoload": {
        "psr-4": {
            "Mfd\\CloudfrontTrustedProxies\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mfd\\CloudfrontTrustedProxies\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "cloudfront_trusted_proxies"
        }
    },
    "scripts": {
        "test:unit": "phpunit -c Build/UnitTests.xml",
        "test:unit:docker": "Build/Scripts/runTests.sh -s unit"
    }
}
